# =============================================================================
# COPY FILE NÀY THÀNH .env VÀ ĐIỀN GIÁ TRỊ THẬT (KHÔNG COMMIT .env)
# =============================================================================

# --- SERVER ---
PORT=3000
NODE_ENV=development

# --- MYSQL (Docker Compose hoặc local) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=uteshop_db

# --- REDIS (OTP đăng ký + có thể dùng cho cache sau này) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# --- JWT ---
JWT_ACCESS_SECRET=28af1f93a1976ba03ffbb838151cac17f531cec5772583a01403b871c5913772
JWT_REFRESH_SECRET=88f96b6dd1abec55685333fd8097fd523e56f9f7599ee9615a6fc466149b9f4b
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- OTP (Redis key: register:otp:<email_thường>) ---
OTP_TTL_SECONDS=600

# =============================================================================
# EMAIL — CHỌN 1 TRONG 2 CÁCH DƯỚI ĐÂY KHI DEV
# =============================================================================

# --- CÁCH 1 (khuyến nghị khi dev): KHÔNG GỬI SMTP — OTP IN RA TERMINAL CHẠY API ---
# Đặt true → đăng ký không gọi Gmail; xem OTP trong console hoặc: npm run otp:peek -- email@cuaban.com
# Production: đặt false và cấu hình Gmail/CÁCH 2 bên dưới.
OTP_DEV_CONSOLE=false

# --- CÁCH 2: GỬI MAIL THẬT QUA GMAIL ---
# Bước bắt buộc trên tài khoản Google:
#   1) Google Account → Bảo mật → bật "Xác minh 2 bước".
#   2) Tìm "Mật khẩu ứng dụng" (App passwords) → chọn ứng dụng Mail / Thiết bị khác → Tạo.
#   3) Copy 16 ký tự vào MAIL_PASS (có thể dán cả chuỗi có dấu cách — code sẽ bỏ).
# TUYỆT ĐỐI KHÔNG dùng mật khẩu đăng nhập Gmail thường — Google luôn trả lỗi 535 BadCredentials.
#
# MAIL_USER = đúng địa chỉ Gmail dùng để tạo App Password (thường ...@gmail.com).
# Google Workspace: nếu admin tắt SMTP/App Password thì vẫn 535 — cần admin bật hoặc dịch vụ mail khác.
#
# Khi gửi Gmail, giữ:
MAIL_TRANSPORT=gmail
MAIL_USER=your_emaail@gmail.com
MAIL_PASS=16_ky_tu_app_password

# Khi OTP_DEV_CONSOLE=false, hai biến trên là BẮT BUỘC.
# Các biến HOST/PORT bên dưới CHỈ dùng khi MAIL_TRANSPORT=smtp (không phải Gmail).

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# --- Nội dung hiển thị trong email OTP (tuỳ chọn) ---
MAIL_FROM_NAME=UTEShop
APP_NAME=UTEShop
MAIL_SUPPORT=support@example.com

# =============================================================================
# SMTP TUỲ CHỈNH (Outlook, Mailtrap, SendGrid...) — MAIL_TRANSPORT=smtp
# =============================================================================
# MAIL_TRANSPORT=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USER=...
# MAIL_PASS=...
